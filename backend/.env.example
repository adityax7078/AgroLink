PORT=5000

# SQLite (default, ephemeral on Render — data resets on redeploy)
DATABASE_URL="file:./prisma/dev.db"

# For persistent data use a hosted DB (Neon, Railway, Supabase) and change provider to postgresql:
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

JWT_SECRET="your_strong_random_jwt_secret_here"

# === URLs (required for CORS and OAuth callbacks) ===
FRONTEND_URL="https://your-frontend.vercel.app"
BACKEND_URL="https://your-service.onrender.com"

# === Gemini AI (get free key at https://aistudio.google.com/app/apikey) ===
GEMINI_API_KEY="your_gemini_api_key_here"

# === OAuth (set to "mock" if not using real OAuth) ===
GOOGLE_CLIENT_ID="mock"
GOOGLE_CLIENT_SECRET="mock"
GITHUB_CLIENT_ID="mock"
GITHUB_CLIENT_SECRET="mock"
